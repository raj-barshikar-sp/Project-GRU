# Gemini API (Google AI Studio)
GOOGLE_API_KEY=your_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=0

# Vertex AI (alternative to GOOGLE_API_KEY)
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_CLOUD_QUOTA_PROJECT=your-gcp-project-id
# ADK_DISABLE_JSON_SCHEMA_FOR_FUNC_DECL=1

# Optional runtime knobs
# SELLER_COPILOT_MODEL=gemini-3.6-flash
# SELLER_COPILOT_SYNTHESIS_MODEL=gemini-3.6-flash
# SELLER_COPILOT_MOCK_LATENCY_SECONDS=0.5
# SELLER_COPILOT_UI_REASONING=1

# Deployed Agent Engine registry (see agents/remote/registry.yaml)
# AGENT_ENGINE_REGISTRY_PATH=agents/remote/registry.yaml
# AGENT_ENGINE_EXAMPLE_AGENT_RESOURCE=projects/your-project/locations/us-central1/reasoningEngines/123
