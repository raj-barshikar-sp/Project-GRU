# Local deterministic data sources
# HENRY_DATA_DIR=/absolute/path/to/henry_dsr_agent/data
HENRY_MOCK_LATENCY_MS=75
HENRY_MOCK_LATENCY_JITTER_MS=25

# Convenient values for local launch scripts and `henry serve` flags
HENRY_HOST=127.0.0.1
HENRY_PORT=8000
HENRY_LOG_LEVEL=info
HENRY_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
